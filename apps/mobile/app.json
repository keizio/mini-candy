{
  "expo": {
    "name": "Mini Candy",
    "slug": "mini-candy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "minicandy",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF5E6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.minicandy.game"
    },
    "android": {
      "package": "com.minicandy.game",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#FFF5E6"
      },
      "predictiveBackGestureEnabled": false,
      "googleMobileAdsAppId": "ca-app-pub-xxxxxxxxxxxxxxxx"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "react-native-google-mobile-ads"
    ]
  }
}
